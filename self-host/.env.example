# --- PostHog ---
POSTHOG_API_KEY=phc_replace_me
# US cloud: https://us.i.posthog.com   EU cloud: https://eu.i.posthog.com
POSTHOG_API_URL=https://us.i.posthog.com

# --- LiteLLM admin key ---
# Generate: openssl rand -hex 32 | sed 's/^/sk-/'
LITELLM_MASTER_KEY=sk-replace-with-strong-random-string

# --- auth2api passthrough key ---
# auth2api enforces this on every request. Generate:
#   openssl rand -hex 32 | sed 's/^/a2a-/'
AUTH2API_PASSTHROUGH_KEY=a2a-replace-with-strong-random-string

# --- Postgres ---
# IMPORTANT: Postgres only honors POSTGRES_PASSWORD on first init.
# After the data volume is initialized, this value is baked in.
# Changing it later requires destroying the volume (see README "Reset DB").
# Set this BEFORE the first `docker compose up`.
POSTGRES_PASSWORD=replace-with-strong-db-password

# DATABASE_URL must percent-encode reserved chars in the password
# (@ -> %40, : -> %3A, / -> %2F, etc.). Keep in sync with POSTGRES_PASSWORD.
# Example: if POSTGRES_PASSWORD=hello@world, use llmproxy:hello%40world
DATABASE_URL=postgresql://llmproxy:replace-encoded-db-password@db:5432/litellm
